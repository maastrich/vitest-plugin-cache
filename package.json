{
  "name": "@maastrich/vitest-plugin-cache",
  "version": "0.1.0",
  "private": false,
  "description": "A Vitest plugin to cache test results based on import trees",
  "keywords": [
    "cache",
    "import-tree",
    "performance",
    "plugin",
    "testing",
    "vitest"
  ],
  "homepage": "https://github.com/maastrich/vitest-plugin-cache#readme",
  "bugs": {
    "url": "https://github.com/maastrich/vitest-plugin-cache/issues"
  },
  "license": "MIT",
  "author": {
    "name": "Mathis Pinsault",
    "email": "pinsaultm@gmail.com",
    "url": "https://github.com/maastrich"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/maastrich/vitest-plugin-cache.git"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./pool": {
      "types": "./dist/pool.d.mts",
      "import": "./dist/pool.mjs"
    }
  },
  "scripts": {
    "build": "vp pack",
    "test": "vp test",
    "type-check": "vp lint --type-aware",
    "lint": "vp lint",
    "lint:fix": "vp lint --fix",
    "format": "vp fmt --check",
    "format:fix": "vp fmt",
    "check": "vp check",
    "check:fix": "vp check --fix",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "vp pack && changeset publish",
    "prepack": "vp pack",
    "prepublishOnly": "vp check && vp test",
    "prepare": "vp config"
  },
  "dependencies": {
    "@maastrich/hashup": "^0.9.1",
    "@ungap/structured-clone": "^1.3.0",
    "@vitest/runner": "~4.1.0"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.0",
    "@types/node": "^22.0.0",
    "@types/ungap__structured-clone": "^1.2.0",
    "typescript": "^7.0.2",
    "vite-plus": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "vite": "^7.0.0",
    "vitest": "~4.1.0"
  },
  "engines": {
    "node": ">=18",
    "pnpm": ">=10"
  },
  "packageManager": "pnpm@10.24.0"
}
